{
  "info": {
    "_postman_id": "a23fc889-59e2-459e-8866-4b7c66e83942",
    "name": "WaveRank-2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "54116243",
    "_collection_link": "https://go.postman.co/collection/54116243-a23fc889-59e2-459e-8866-4b7c66e83942?source=collection_link"
  },
  "item": [
    {
      "name": "Valid Uploads Parallel",
      "item": [
        {
          "name": "Upload Same mp3 as WaveRank-1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Graphs exist\", function () {\r",
                  "    pm.expect(jsonData.graphs.waveform).to.exist;\r",
                  "    pm.expect(jsonData.graphs.spectrum).to.exist;\r",
                  "    pm.expect(jsonData.graphs.spectrogram).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\r",
                  "    \"valid_mp3_waveform_url\",\r",
                  "    jsonData.graphs.waveform\r",
                  ");\r",
                  "pm.environment.set(\r",
                  "    \"valid_mp3_spectrum_url\",\r",
                  "    jsonData.graphs.spectrum\r",
                  ");\r",
                  "pm.environment.set(\r",
                  "    \"valid_mp3_spectrogram_url\",\r",
                  "    jsonData.graphs.spectrogram\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "uuid": "5020327e-d8c5-4d0b-b3cf-69ac1e32c0d0",
                  "src": "{{test_assets_dir}}/valid.mp3"
                }
              ]
            },
            "url": {
              "raw": "{{server_url}}/api/predict",
              "host": [
                "{{server_url}}"
              ],
              "path": [
                "api",
                "predict"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get mp3 Waveform Graph",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{valid_mp3_waveform_url}}",
              "host": [
                "{{valid_mp3_waveform_url}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get mp3 Spectrum Graph",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{valid_mp3_spectrum_url}}",
              "host": [
                "{{valid_mp3_spectrum_url}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get mp3 Spectrogram Graph",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{valid_mp3_spectrogram_url}}",
              "host": [
                "{{valid_mp3_spectrogram_url}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
